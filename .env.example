# --- Logowanie ---

# Sekret do podpisywania sesji/JWT. To NIE jest hasło do konta - to losowy
# klucz techniczny Auth.js. Wygeneruj przez: openssl rand -base64 32
AUTH_SECRET=

# Adres, pod którym appka jest dostępna (potrzebne przez Auth.js do callbacków)
AUTH_URL=http://localhost:3417

# Dane z GitHub OAuth App (github.com -> Settings -> Developer settings
# -> OAuth Apps -> New OAuth App). Jako "Authorization callback URL" podaj:
# http://localhost:3417/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Lista e-maili (po przecinku, bez spacji), którym WOLNO zalogować się
# przez GitHub. Bez tego każdy z kontem GitHub mógłby się zalogować.
ALLOWED_EMAILS=ja@example.com,zona@example.com

DATABASE_URL=